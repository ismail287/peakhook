# PeakHook configuration. Copy this file to ".env" and edit:   cp .env.example .env
# docker compose reads .env automatically. Lines starting with # are comments.

# --- Required -----------------------------------------------------------------
# Password for the dashboard and the admin API. Log in with ANY username and this password.
# "admin123" is only a placeholder: CHANGE IT before you expose PeakHook to the internet.
ADMIN_PASSWORD=admin123

# --- Common -------------------------------------------------------------------
# Port the app listens on inside the container / on your machine without Docker.
PORT=3000

# Webhooks (and their delivery history) older than this many days are deleted
# automatically. Set 0 to keep everything forever.
RETENTION_DAYS=30

# Forward webhooks that arrive on an endpoint WITHOUT its own forward URL to this URL
# (for example your n8n production webhook URL). Leave empty to only store them.
DEFAULT_FORWARD_URL=

# --- Behind a reverse proxy / custom domain -----------------------------------
# true  = trust X-Forwarded-For / X-Forwarded-Proto from your proxy (correct client IPs, https URLs).
TRUST_PROXY=false
# Public address shown in the dashboard, e.g. https://hooks.example.com  (leave empty to auto-detect).
PUBLIC_URL=

# --- Limits -------------------------------------------------------------------
# Largest webhook body accepted, in bytes (default 1 MB). Bigger requests get HTTP 413.
MAX_BODY_BYTES=1048576
# How long to wait for your n8n/Make/Zapier URL to answer before marking the delivery as timed out.
FORWARD_TIMEOUT_MS=10000

# --- Only used by docker-compose.n8n-stack.yml --------------------------------
# Required for the n8n stack: pick long random values (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
N8N_ENCRYPTION_KEY=change-me-to-another-long-random-string
# Optional:
# POSTGRES_USER=n8n
# POSTGRES_DB=n8n
# N8N_VERSION=latest
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# N8N_WEBHOOK_URL=http://localhost:5678/
# N8N_SECURE_COOKIE=false   # set to true when n8n is served over HTTPS
# TZ=UTC
